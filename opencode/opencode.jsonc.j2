{
  // NOTE: V2 shell permissions use whole-command glob matching, not shell parsing.
  // A "*" can span spaces, so middle wildcards can match unintended commands if an
  // argument contains a verb-like word. See the git -C and gcloud rules below.
  "$schema": "https://opencode.ai/config.json",
  // Default model: EnMaaS GLM, or openai/gpt-6-luna when enmaas is disabled
  // (config.jsonc) — used for model + build/title/compaction/summary agents.
