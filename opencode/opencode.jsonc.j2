      // "package": "@opencode/ai/providers/openai-compatible",
      "package": "@opencode/ai/providers/openai-compatible-responses",
      "settings": {
        "baseURL": "https://api.enmaas.devshift.net/v1",
        "apiKey": "{file:~/.secrets/enmaas-key}"
      },
      "models": {
        "gpt-6-luna": {
          "name": "GPT-6 Luna",
          // "settings": {
          //   "reasoningEffort": "high"
          // },
          "limit": {
            "context": 1050000,
            "output": 128000
          }
        },
        "gpt-6-sol": {
          "name": "GPT-6 Sol",
          "limit": {
            "context": 1050000,
            "output": 128000
          }
        },
        "gpt-6-astra": {
          "name": "GPT-6 Astra",
          "limit": {
            "context": 1050000,
            "output": 128000
          }
        },
      }
    },
  },
  // Hide opencode's built-in free "opencode" provider (gateway models).
  "disabled_providers": ["opencode"],
  "model": "{{ default_model }}",
  "agents": {
    "plan": {
      "model": "openai/gpt-6-astra"
    },
