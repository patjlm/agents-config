    // EnMaaS setup notes: https://source.redhat.com/departments/products_and_global_engineering/workload_management/enmaas
    // Keep EnMaaS under separate provider IDs so existing OpenAI/Vertex routes stay unchanged.
    "enmaas-free": {
      "name": "EnMaaS Free Tier",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.enmaas.devshift.net/v1",
        "apiKey": "{file:~/.secrets/enmaas-key}"
      },
      "models": {
        "rits/zai-org/glm-5-3": {
          "name": "GLM 5.3",
          "limit": {
            "context": 1050000,
            "output": 65536
          }
        },
        // Secondary option next to GLM — vision-capable (verified: image
        // input works over /v1/chat/completions), unlike GLM. Limits not
        // exposed by the EnMaaS API; announced 1M context, 64K output
        // assumed like GLM.
        "rits/deepseek-ai/DeepSeek-V4.1-Flash-1017": {
          "name": "DeepSeek V4.1 Flash 1017",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "capabilities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      }
    },

