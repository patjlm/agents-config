{
  // Repo-wide settings, rendered into every agent config at install time.
  "enmaas": {
    // false = EnMaaS is down: agents fall back to non-EnMaaS providers
    // (claude: Vertex via gcloud ADC; opencode: openai; codex: default
    // OpenAI/ChatGPT auth; omp: openai via key file; pi: vertex via the
    // pi-vertex extension).
    // Flip + re-run install.py to switch.
    "enabled": true,
    // Free EnMaaS model for claude code's haiku alias (background tasks
    // such as session titles) instead of claude-haiku-5-5. It does not
    // affect the auto-mode classifier — see claude/auto-mode-classifier.md.
    // Switch to another free model (e.g.
    // rits/deepseek-ai/DeepSeek-V4.1-Flash-1017) when this one is
    // unavailable but EnMaaS still serves the claude models; null =
    // claude-haiku-5-5.
    "aux_model": "rits/zai-org/glm-5-3"
  }
}
