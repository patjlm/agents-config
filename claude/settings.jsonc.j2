{
  // Jinja template: rendered by install.py with {{ home }} / {{ repo }}
  // substitution, then serialized to plain JSON (Claude Code can't read
  // comments) into ~/.claude/settings.json. The installed file is compared
  // as parsed JSON, so Claude Code's own reformatting doesn't trigger
  // reinstalls.
{% if enmaas_enabled %}
  "apiKeyHelper": "cat ~/.secrets/enmaas-key",
{% endif %}
  "env": {
    "ENABLE_TOOL_SEARCH": "auto:0",
{% if enmaas_enabled and aux_model %}
    // aux_model (config.jsonc): this free EnMaaS model also covers cheap
    // auxiliary usage — the haiku alias (background tasks) and the
    // auto-mode classifier below.
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "{{ aux_model }}",
{% else %}
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-5-5",
{% endif %}
    "ANTHROPIC_VERTEX_PROJECT_ID": "itpc-ca-0ae3c7024b",
{% if enmaas_enabled %}
    "ANTHROPIC_BASE_URL": "https://api.enmaas.devshift.net",
    "CLAUDE_CODE_USE_VERTEX": "",
    "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY": "1",
    // EnMaaS doesn't implement the server-side auto-mode safety review
    // (safeguards field / safeguard_results) — verified: with =1 the extra
    // fields are ignored and claude falls back to the same client-side
    // classifier. Classifier details: see claude/auto-mode-classifier.md.
    "CLAUDE_CODE_AUTO_MODE_SERVER": "0"
{% else %}
    // enmaas disabled (config.jsonc): Vertex via gcloud ADC
    "CLAUDE_CODE_USE_VERTEX": "1"
{% endif %}
    // "Resume compaction" prompt ("This session is Xm old and uses N
    // tokens. Compact it before continuing?"): fires when a session is
    // resumed after ≥ this many idle minutes AND holds ≥ the token
    // threshold below — regardless of the model's context window (fires
    // at the 100K default even on GLM's 1M window). Undocumented env
    // vars (claude code 2.1.300). Raise to be asked less often, or
    // answer "Don't ask again" in the prompt itself.
    // "CLAUDE_CODE_RESUME_THRESHOLD_MINUTES": "240",   // default 70
    // "CLAUDE_CODE_RESUME_TOKEN_THRESHOLD": "400000"   // default 100000
  },
  // Claude Code writes granted permissions here ("always allow" etc.) —
  // installs warn about keys/values it holds that this source doesn't.
  "permissions": {},
  // Sandbox write allowlist for tooling caches — applies whenever the
  // sandbox is on (enabled per-project, e.g. gcp-hcp-infra; this file
  // deliberately doesn't set sandbox.enabled). Caches only, no broad home
  // writes: ~/.terraform.d itself stays unwritable (credentials.tfrc.json
  // lives there) — only its plugin-cache subdir (per ~/.terraformrc).
  // Deliberately left out: ~/.cache/terraform (unused on this machine),
  // poetry (absent), mise/asdf dirs (toolchain installs, not caches).
  "sandbox": {
    "filesystem": {
      "allowWrite": [
        "~/.cache/uv",
        "~/.local/share/uv",
        "~/.cache/go-build",
        "~/go/pkg/mod",
        "~/.terraform.d/plugin-cache",
        "~/.cache/pip",
        "~/.cargo/registry",
        "~/.cargo/git",
        "~/.cache/helm"
      ]
    }
  },
{% if enmaas_enabled %}
  "model": "rits/zai-org/glm-5-3[1m]",
{% else %}
  "model": "claude-sonnet-5-5",
{% endif %}
  "modelPicker": {
    "options": [
{% if enmaas_enabled %}
      {
        "model": "rits/zai-org/glm-5-3[1m]",
        "label": "GLM 5.3",
        "description": "Hosted via EnMaaS"
      },
      {
        // secondary option next to GLM — vision-capable over EnMaaS's
        // anthropic-compatible endpoint (verified), unlike GLM
        "model": "rits/deepseek-ai/DeepSeek-V4.1-Flash-1017[1m]",
        "label": "DeepSeek V4.1 Flash",
        "description": "Hosted via EnMaaS"
      }
{% else %}
      {
        "model": "claude-sonnet-5-5",
        "label": "Claude Sonnet 5.5",
        "description": "Vertex via gcloud ADC"
      },
      {
        "model": "claude-opus-5-5",
        "label": "Claude Opus 5.5",
        "description": "Vertex via gcloud ADC"
      }
{% endif %}
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{ home }}/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash {{ home }}/.claude/statusline-command.sh"
  },
  // true = install (applied via the claude CLI by install.py, idempotent)
  "enabledPlugins": {
    "mcp@patjlm-agents-config": true,
    "caveman@caveman": true,
    "ci@ai-helpers": true,
    "gcp-hcp@gcp-hcp": true,
    "golang@ai-helpers": false,
    "gopls-lsp@claude-plugins-official": true,
    "hcp@ai-helpers": true,
    "jira@ai-helpers": true,
    "teams@ai-helpers": true,
    "code-review@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "juliusbrussee/caveman"
      }
    },
    "ai-helpers": {
      "source": {
        "source": "github",
        "repo": "openshift-eng/ai-helpers"
      }
    },
    "gcp-hcp": {
      "source": {
        "source": "github",
        "repo": "openshift-online/gcp-hcp"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "patjlm-agents-config": {
      "source": {
        "source": "directory",
        "path": "{{ repo }}/claude/plugins"
      }
    }
  },
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "high"
    },
    "rits/zai-org/glm-5-3": {
      "effortLevel": "high"
    }
  },
  "skipWorkflowUsageWarning": true,
  "theme": "light"
}
