{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Canonical MCP server list shared across agents",
  "type": "object",
  "additionalProperties": { "$ref": "#/$defs/server" },
  "$defs": {
    "server": {
      "oneOf": [
        { "$ref": "#/$defs/remote" },
        { "$ref": "#/$defs/local" }
      ]
    },
    "agent_overrides": {
      "type": "object",
      "description": "Per-agent overrides: deep-merged over the base server when rendering for that agent (dicts merge per-key, scalars/lists replace). 'exclude': true skips the server for that agent. Override keys are opencode-shaped; override values are written in the target agent's syntax.",
      "properties": {
        "exclude": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "remote": {
      "type": "object",
      "properties": {
        "type": { "const": "remote" },
        "url": { "type": "string" },
        "oauth": { "type": "boolean" },
        "headers": { "type": "object", "additionalProperties": { "type": "string" } },
        "disabled": { "type": "boolean" },
        "claude": { "$ref": "#/$defs/agent_overrides" },
        "codex": { "$ref": "#/$defs/agent_overrides" },
        "opencode": { "$ref": "#/$defs/agent_overrides" },
        "omp": { "$ref": "#/$defs/agent_overrides" }
      },
      "required": ["type", "url"],
      "additionalProperties": false
    },
    "local": {
      "type": "object",
      "properties": {
        "type": { "const": "local" },
        "command": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "cwd": { "type": "string" },
        "environment": { "type": "object", "additionalProperties": { "type": "string" } },
        "disabled": { "type": "boolean" },
        "claude": { "$ref": "#/$defs/agent_overrides" },
        "codex": { "$ref": "#/$defs/agent_overrides" },
        "opencode": { "$ref": "#/$defs/agent_overrides" },
        "omp": { "$ref": "#/$defs/agent_overrides" },
        "timeout": {
          "type": "object",
          "properties": {
            "catalog": { "type": "integer", "exclusiveMinimum": 0 },
            "execution": { "type": "integer", "exclusiveMinimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "required": ["type", "command"],
      "additionalProperties": false
    }
  }
}
