{
  "atlassian": {
    "type": "remote",
    // v2 (v1 sunset 2027-03-01). `tools=all` keeps the flat tool list: without
    // it v2 exposes only a few Primary tools and defers the rest behind
    // discover/execute*, which the per-tool permission allowlist can't name.
    "url": "https://mcp.atlassian.com/v2/mcp?tools=all",
    // claude: provided by the jira@ai-helpers plugin instead
    "claude": { "exclude": true }
  },
  // "categorizer": {
  //   // Tailscale host on the home LAN — unreachable off-tailnet, so protocols
  //   // that hard-fail on connect should stay lazy where the agent allows it.
  //   "type": "remote",
  //   "url": "http://raspberrypi.tail496359.ts.net:9098/mcp/"
  // },
  // Disabled 2026-11-12: the Raspberry Pi host is offline, so the TCP connect
  // hangs and stalls agent startup. Uncomment once the host is back on the tailnet.
  "chai-bot-gcp-hcp-engineering": {
    "type": "remote",
    "url": "https://ship-help-mcp-continuous-release-toolting--ship-help-bot.apps.gpc.ocp-hub.prod.psi.redhat.com/personas/gcp_hcp_engineering/mcp",
    "oauth": false,
    // disabled: unused, and the deployed bot answers 503. Flip to re-enable.
    "disabled": true,
    "headers": {
      // opencode reads the token file at runtime
      "Authorization": "Bearer {file:~/.secrets/chai-bot-gcp-hcp-engineering-token}"
    },
    // claude can't read files — use the env var (set in bashrc) instead
    "claude": {
      "headers": {
        "Authorization": "Bearer ${CHAI_BOT_GCP_HCP_ENGINEERING_TOKEN}"
      }
    },
    // codex reads the bearer token from the env var (same one as claude)
    "codex": {
      "bearer_token_env_var": "CHAI_BOT_GCP_HCP_ENGINEERING_TOKEN"
    }
  },
  "decision-support": {
    "type": "local",
    "command": ["uv", "run", "--script", "decision_mcp.py"],
    "cwd": "/home/patmarti/dev/llama-cpp-bin",
    "disabled": true,
    "timeout": {
      "catalog": 180000,
      "execution": 180000
    }
  },
  "google-workspace": {
    "type": "remote",
    // Red Hat internal deployment; OAuth 2.1 (PKCE, dynamic client
    // registration) — no headers: each agent authenticates per user.
    "url": "https://gworkspace.corp.redhat.com/mcp"
  }
  // Slack is harness-only: defined in harnesses/slack/harness.jsonc, so no
  // regular agent renders it (see the harness rules in AGENTS.md).
  // GitHub MCP disabled — prefer gh CLI for now.
  // "github": {
  //   "type": "remote",
  //   "url": "https://api.githubcopilot.com/mcp/",
  //   "headers": {
  //     "headers": {
  //       "Authorization": "Bearer {file:~/.secrets/github-pat}"
  //     },
  //     "claude": {
  //       "headers": {
  //         "Authorization": "Bearer ${GITHUB_MCP_PAT}"
  //       }
  //     }
  //   }
  // }
}
