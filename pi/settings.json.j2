{% set default_provider = "enmaas-glm" if enmaas_enabled else "vertex" %}
{% set default_model = "rits/zai-org/glm-5-3" if enmaas_enabled else "claude-haiku-4-5" %}
{
  "defaultProvider": "{{ default_provider }}",
  "defaultModel": "{{ default_model }}",
  "defaultThinkingLevel": "medium",
  "packages": [
    "npm:@lhl/pi-vertex",
    "npm:pi-subagents"
  ],
  "theme": "dark"
}
