{% set default_provider = "enmaas-deepseek" if enmaas_enabled else "vertex" %}
{% set default_model = "rits/deepseek-ai/DeepSeek-V4.1-Flash-1017" if enmaas_enabled else "claude-opus-4-6" %}
{
  "defaultProvider": "{{ default_provider }}",
  "defaultModel": "{{ default_model }}",
  "defaultThinkingLevel": "medium",
  "packages": [
    "npm:@lhl/pi-vertex",
    "npm:pi-subagents",
    "npm:pi-web-access"
  ],
  "theme": "dark"
}
