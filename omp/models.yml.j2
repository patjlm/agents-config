# Rendered by install.py from omp/models.yml.j2 — never hand-edit
# ~/.omp/agent/models.yml (edit the template + re-run install).
# EnMaaS sits under its own provider IDs so omp's built-in providers
# (openai, anthropic, ...) stay unchanged — same convention as opencode.
providers:
  # GLM 5.3 over the completions API. Proven flags for GLM's vLLM backend:
  # no developer role, penalties zeroed. The API key is read from the secret
  # file at request time — command form; quoted, because a leading ! would
  # otherwise parse as a YAML tag.
  enmaas-glm:
    baseUrl: https://api.enmaas.devshift.net/v1
    apiKey: "!cat {{ home }}/.secrets/enmaas-key"
    api: openai-completions
    models:
      - id: rits/zai-org/glm-5-3
        name: GLM 5.3 (EnMaaS)
        reasoning: true
        input:
          - text
        contextWindow: 1000000
        maxTokens: 65536
        cost:
          input: 0
          output: 0
          cacheRead: 0
          cacheWrite: 0
        compat:
          supportsDeveloperRole: false
        samplingParams:
          frequency_penalty: 0
          presence_penalty: 0
  # DeepSeek V4.1 Flash over the completions API — secondary option next to
  # GLM. Unlike GLM's vLLM backend it accepts the developer role and
  # sampling penalties natively (verified), so compat only declares that;
  # it also takes image input. Limits not exposed by the EnMaaS API;
  # announced 1M context, 64K output assumed like GLM.
  enmaas-deepseek:
    baseUrl: https://api.enmaas.devshift.net/v1
    apiKey: "!cat {{ home }}/.secrets/enmaas-key"
    api: openai-completions
    models:
      - id: rits/deepseek-ai/DeepSeek-V4.1-Flash-1017
        name: DeepSeek V4.1 Flash 1017 (EnMaaS)
        reasoning: true
        input:
          - text
          - image
        contextWindow: 1048576
        maxTokens: 65536
        cost:
          input: 0
          output: 0
          cacheRead: 0
          cacheWrite: 0
        compat:
          supportsDeveloperRole: true
  # Meta Muse Spark Open (816B total / 42B active, NVFP4) over the
  # completions API — third free option next to GLM and DeepSeek, and
  # vision-capable like DeepSeek. Verified live: developer role, function
  # tools with reasoning effort, image input, reasoning_content on the way
  # back. Never use the [1m] suffix here — that is a Claude Code alias for
  # the same 1M window, and EnMaaS 404s on it. Limits not exposed by the
  # EnMaaS API; announced 1M context, 64K output assumed like GLM.
  enmaas-muse:
    baseUrl: https://api.enmaas.devshift.net/v1
    apiKey: "!cat {{ home }}/.secrets/enmaas-key"
    api: openai-completions
    models:
      - id: rits/meta-models/Muse-Spark-Open-816B-A42B-NVFP4
        name: Muse Spark Open 816B (EnMaaS)
        reasoning: true
        input:
          - text
          - image
        contextWindow: 1000000
        maxTokens: 65536
        cost:
          input: 0
          output: 0
          cacheRead: 0
          cacheWrite: 0
        compat:
          supportsDeveloperRole: true
  # Gemini 4 Neon over the completions API — the paid heavy-reasoning
  # alternative to enmaas-anthropic's claude-opus-5-5. Verified live: function
  # tools with reasoning_effort, image input, streaming, developer role.
  # Needs the thought_signature replay in
  # pi/extensions/gemini-thought-signature.ts (install.py links it into
  # ~/.omp/agent/extensions): Vertex 400s a tool result whose
  # assistant call carries no signature, and the OpenAI-compatible payload
  # drops it. reasoning_effort takes minimal/low/medium/high/max — no "none",
  # so thinking cannot be turned off (default high); xhigh is unmapped. Not on
  # /v1/responses or the anthropic endpoint, so only the OpenAI-compatible
  # agents can run it. Cost: Vertex list price per 1M tokens, passed through
  # by EnMaaS (input $3.00, cache read $0.15, cache write $3.75, output
  # $15.00 on the global endpoint; non-global $3.30/$0.165/$4.125/$16.50),
  # from https://cloud.google.com/vertex-ai/generative-ai/pricing.
  enmaas-google:
    baseUrl: https://api.enmaas.devshift.net/v1
    apiKey: "!cat {{ home }}/.secrets/enmaas-key"
    api: openai-completions
    models:
      - id: gemini-4-neon
        name: Gemini 4 Neon (EnMaaS)
        reasoning: true
        input:
          - text
          - image
        contextWindow: 1000000
        maxTokens: 65536
        cost:
          input: 3.0
          output: 15.0
          cacheRead: 0.15
          cacheWrite: 3.75
        thinkingLevelMap:
          off: null
          minimal: minimal
          low: low
          medium: medium
          high: high
          xhigh: null
          max: max
        compat:
          supportsDeveloperRole: true
  # gpt profile models over the responses API — the completions API rejects
  # function tools with reasoning effort (same finding as opencode/codex).
  # These entries are constructed from our opencode limits, not proven by
  # the colleague config the GLM entry came from. No cost block: EnMaaS bills
  # them at negotiated rates we don't know (only GLM and DeepSeek are free).
  enmaas-openai:
    baseUrl: https://api.enmaas.devshift.net/v1
    apiKey: "!cat {{ home }}/.secrets/enmaas-key"
    api: openai-responses
    models:
      - id: gpt-6-luna
        name: GPT-6 Luna (EnMaaS)
        reasoning: true
        input:
          - text
        contextWindow: 1050000
        maxTokens: 128000
      - id: gpt-6-sol
        name: GPT-6 Sol (EnMaaS)
        reasoning: true
        input:
          - text
        contextWindow: 1050000
        maxTokens: 128000
      - id: gpt-6-astra
        name: GPT-6 Astra (EnMaaS)
        reasoning: true
        input:
          - text
        contextWindow: 1050000
        maxTokens: 128000
  # Claude models over EnMaaS's anthropic-compatible endpoint. omp derives the
  # thinking mode from the model id: adaptive on every Claude 5.5 model
  # (opus/sonnet/haiku) — all three reasoning, all verified live. Three
  # overrides the gateway requires (without them the request 401s or 400s):
  # - headers.X-Api-Key: omp defaults to "Authorization: Bearer" for non-official
  #   anthropic baseUrls; EnMaaS only accepts x-api-key.
  # - disableStrictTools (provider-level key, not compat): EnMaaS's Vertex
  #   backend rejects Anthropic strict tool schemas ("disallowed feature
  #   structured_outputs"), which omp would otherwise set on builtin edit tools.
  # - compat.supportsContextManagement: false — the gateway rejects the
  #   experimental context_management field.
  # No cost block: EnMaaS bills these at negotiated rates we don't know (only
  # GLM and DeepSeek are free).
  enmaas-anthropic:
    baseUrl: https://api.enmaas.devshift.net
    apiKey: "!cat {{ home }}/.secrets/enmaas-key"
    headers:
      X-Api-Key: "!cat {{ home }}/.secrets/enmaas-key"
    api: anthropic-messages
    disableStrictTools: true
    compat:
      supportsContextManagement: false
    models:
      - id: claude-opus-5-5
        name: Claude Opus 5.5 (EnMaaS)
        reasoning: true
        input:
          - text
          - image
        contextWindow: 1000000
        maxTokens: 128000
      - id: claude-sonnet-5-5
        name: Claude Sonnet 5.5 (EnMaaS)
        reasoning: true
        input:
          - text
          - image
        contextWindow: 1000000
        maxTokens: 128000
      - id: claude-haiku-5-5
        name: Claude Haiku 5.5 (EnMaaS)
        reasoning: true
        input:
          - text
          - image
        contextWindow: 1000000
        maxTokens: 128000
  # Fallback when EnMaaS is down (config.jsonc enmaas.enabled=false) —
  # direct OpenAI with the personal key file, mirroring opencode's
  # fallback. install.py then routes modelRoles.default here.
  openai-key:
    baseUrl: https://api.openai.com/v1
    apiKey: "!cat {{ home }}/.secrets/openai-api-key"
    api: openai-responses
    models:
      - id: gpt-6-luna
        name: GPT-6 Luna (OpenAI)
        reasoning: true
        input:
          - text
        contextWindow: 1050000
        maxTokens: 128000
