# Rendered by install.py from omp/models.yml.j2 — never hand-edit
# ~/.omp/agent/models.yml (edit the template + re-run install).
# EnMaaS sits under its own provider IDs so omp's built-in providers
# (openai, anthropic, ...) stay unchanged — same convention as opencode.
providers:
  # GLM 5.3 over the completions API. Proven flags for GLM's vLLM backend:
  # no developer role, penalties zeroed. The API key is read from the secret
  # file at request time — command form; quoted, because a leading ! would
  # otherwise parse as a YAML tag.
  enmaas-glm:
    baseUrl: https://api.enmaas.devshift.net/v1
    apiKey: "!cat {{ home }}/.secrets/enmaas-key"
    api: openai-completions
    models:
      - id: rits/zai-org/glm-5-3
        name: GLM 5.3 (EnMaaS)
        reasoning: true
        input:
          - text
        contextWindow: 1000000
        maxTokens: 65536
        cost:
          input: 0
          output: 0
          cacheRead: 0
          cacheWrite: 0
        compat:
          supportsDeveloperRole: false
        samplingParams:
          frequency_penalty: 0
          presence_penalty: 0
  # DeepSeek V4.1 Flash over the completions API — secondary option next to
  # GLM. Unlike GLM's vLLM backend it accepts the developer role and
  # sampling penalties natively (verified), so compat only declares that;
  # it also takes image input. Limits not exposed by the EnMaaS API;
  # announced 1M context, 64K output assumed like GLM.
  enmaas-deepseek:
    baseUrl: https://api.enmaas.devshift.net/v1
    apiKey: "!cat {{ home }}/.secrets/enmaas-key"
    api: openai-completions
    models:
      - id: rits/deepseek-ai/DeepSeek-V4.1-Flash-1017
        name: DeepSeek V4.1 Flash 1017 (EnMaaS)
        reasoning: true
        input:
          - text
          - image
        contextWindow: 1048576
        maxTokens: 65536
        cost:
          input: 0
          output: 0
          cacheRead: 0
          cacheWrite: 0
        compat:
          supportsDeveloperRole: true
  # gpt profile models over the responses API — the completions API rejects
  # function tools with reasoning effort (same finding as opencode/codex).
  # These entries are constructed from our opencode limits, not proven by
  # the colleague config the GLM entry came from.
  enmaas-openai:
    baseUrl: https://api.enmaas.devshift.net/v1
    apiKey: "!cat {{ home }}/.secrets/enmaas-key"
    api: openai-responses
    models:
      - id: gpt-6-luna
        name: GPT-6 Luna (EnMaaS)
        reasoning: true
        input:
          - text
        contextWindow: 1050000
        maxTokens: 128000
        cost:
          input: 0
          output: 0
          cacheRead: 0
          cacheWrite: 0
      - id: gpt-6-sol
        name: GPT-6 Sol (EnMaaS)
        reasoning: true
        input:
          - text
        contextWindow: 1050000
        maxTokens: 128000
        cost:
          input: 0
          output: 0
          cacheRead: 0
          cacheWrite: 0
      - id: gpt-6-astra
        name: GPT-6 Astra (EnMaaS)
        reasoning: true
        input:
          - text
        contextWindow: 1050000
        maxTokens: 128000
        cost:
          input: 0
          output: 0
          cacheRead: 0
          cacheWrite: 0
  # Claude models over EnMaaS's anthropic-compatible endpoint. omp derives the
  # thinking mode from the model id: adaptive on every Claude 5.5 model
  # (opus/sonnet/haiku) — all three reasoning, all verified live. Three
  # overrides the gateway requires (without them the request 401s or 400s):
  # - headers.X-Api-Key: omp defaults to "Authorization: Bearer" for non-official
  #   anthropic baseUrls; EnMaaS only accepts x-api-key.
  # - disableStrictTools (provider-level key, not compat): EnMaaS's Vertex
  #   backend rejects Anthropic strict tool schemas ("disallowed feature
  #   structured_outputs"), which omp would otherwise set on builtin edit tools.
  # - compat.supportsContextManagement: false — the gateway rejects the
  #   experimental context_management field.
  enmaas-anthropic:
    baseUrl: https://api.enmaas.devshift.net
    apiKey: "!cat {{ home }}/.secrets/enmaas-key"
    headers:
      X-Api-Key: "!cat {{ home }}/.secrets/enmaas-key"
    api: anthropic-messages
    disableStrictTools: true
    compat:
      supportsContextManagement: false
    models:
      - id: claude-opus-5-5
        name: Claude Opus 5.5 (EnMaaS)
        reasoning: true
        input:
          - text
          - image
        contextWindow: 1000000
        maxTokens: 128000
        cost:
          input: 0
          output: 0
          cacheRead: 0
          cacheWrite: 0
      - id: claude-sonnet-5-5
        name: Claude Sonnet 5.5 (EnMaaS)
        reasoning: true
        input:
          - text
          - image
        contextWindow: 1000000
        maxTokens: 128000
        cost:
          input: 0
          output: 0
          cacheRead: 0
          cacheWrite: 0
      - id: claude-haiku-5-5
        name: Claude Haiku 5.5 (EnMaaS)
        reasoning: true
        input:
          - text
          - image
        contextWindow: 1000000
        maxTokens: 128000
        cost:
          input: 0
          output: 0
          cacheRead: 0
          cacheWrite: 0
  # Fallback when EnMaaS is down (config.jsonc enmaas.enabled=false) —
  # direct OpenAI with the personal key file, mirroring opencode's
  # fallback. install.py then routes modelRoles.default here.
  openai-key:
    baseUrl: https://api.openai.com/v1
    apiKey: "!cat {{ home }}/.secrets/openai-api-key"
    api: openai-responses
    models:
      - id: gpt-6-luna
        name: GPT-6 Luna (OpenAI)
        reasoning: true
        input:
          - text
        contextWindow: 1050000
        maxTokens: 128000
        cost:
          input: 0
          output: 0
          cacheRead: 0
          cacheWrite: 0
