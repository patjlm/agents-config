# Rendered by install.py — never edit ~/.codex/config.toml directly
# (codex mcp add writes there too; installs warn about drift). Global
# instructions: ~/.codex/AGENTS.md (symlinked from the repo).
{% if enmaas_enabled %}
# NOTE: codex only supports the responses wire API (/v1/responses). The
# GLM default assumes EnMaaS serves it over responses; the gpt-* profiles
# (codex --profile gpt-luna ...) use the same endpoint. The API key is
# read from the secret file by the auth command (token on stdout,
# in-memory only, refreshed every 5 min or on 401).
model = "rits/zai-org/glm-5-3"
model_provider = "enmaas"
# GLM runs at high effort (catalog defaults alone aren't applied by codex);
# the gpt-* profiles pin their own effort.
model_reasoning_effort = "high"
{% if catalog_path %}
# /model picker: model_catalog_json replaces codex's catalog — this one
# (generated by install.py) lists exactly the EnMaaS models, GLM included.
model_catalog_json = "{{ catalog_path }}"
{% endif %}

[model_providers.enmaas]
name = "EnMaaS"
base_url = "https://api.enmaas.devshift.net/v1"

[model_providers.enmaas.auth]
# args are argv (no shell/tilde expansion) — hence the absolute path
command = "cat"
args = ["{{ home }}/.secrets/enmaas-key"]

# EnMaaS rejects service_tier=priority — hide the "Fast" (priority) speed
# tier so the /model picker can't select it. Reasoning effort is unaffected.
[features]
fast_mode = false
{% endif %}
# MCP servers from mcp/servers.jsonc
{{ mcp_toml }}